# DeepMT server configuration
PORT=3000
# JSON Web Token secret — change this in production!
JWT_SECRET=change-me-deepmt-local-secret
JWT_EXPIRES=7d
# Path to the SQLite database file
DB_PATH=./data/deepmt.db

# TurboFieldfare loopback OpenAI-compatible server (MT 1.0 Neptune & Jupiter)
# https://github.com/drumih/turbo-fieldfare
TURBOFIELDFARE_URL=http://127.0.0.1:8080/v1
TURBOFIELDFARE_MODEL=gemma-4-26b-a4b-it

# Ollama host (MT 1.0 Lite) — SmolLM3 3B
OLLAMA_URL=http://192.168.0.183:11434
OLLAMA_LITE_MODEL=alibayram/smollm3:latest

# How long (ms) to wait for engine health checks before marking offline
ENGINE_TIMEOUT=2500
# Enable verbose engine logging
ENGINE_DEBUG=true
